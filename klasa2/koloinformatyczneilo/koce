#include <iostream>
using namespace std;
unsigned long long liczkoc, x, y;
int main()
{
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    cin >> liczkoc;
    for(unsigned long long i = 0; i < liczkoc; i++){
        cin >> x >> y;
        while(x > 0 && x%2 == 0){
            x = x/2;
        }
        while(y > 0 && y%2 == 0){
            y = y/2;
        }
        cout << x*y << "\n";
    }
}
